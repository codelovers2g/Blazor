@using Microsoft.AspNetCore.Components.QuickGrid
@using Blazor.Infrastructure.Models

<div class="grid-container">
    <QuickGrid Items="@FilteredProducts" Pagination="@PaginationState" Class="modern-grid">
        <PropertyColumn Property="@(p => p.SKU)" Sortable="true" Title="SKU" />
        <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
        <PropertyColumn Property="@(p => p.Category)" Sortable="true" />
        <PropertyColumn Property="@(p => p.Price)" Sortable="true" Format="C2" />
        
        <TemplateColumn Title="Stock Level" Sortable="true" SortBy="@(GridSort<Product>.ByAscending(p => p.StockLevel))">
            @{
                var p = context;
                var (cssClass, label) = GetStockStatus(p.StockLevel);
                <span class="stock-badge @cssClass">@p.StockLevel (@label)</span>
            }
        </TemplateColumn>

        <TemplateColumn Title="Actions">
            <button class="btn-action" @onclick="@(() => OnEdit.InvokeAsync(context))">
                <i class="bi bi-pencil"></i> Edit
            </button>
        </TemplateColumn>
    </QuickGrid>

    <Paginator State="@PaginationState" />
</div>

@code {
    [Parameter, EditorRequired]
    public IQueryable<Product> Products { get; set; } = default!;

    [Parameter]
    public EventCallback<Product> OnEdit { get; set; }

    [Parameter]
    public string? SearchTerm { get; set; }

    private PaginationState PaginationState { get; } = new() { ItemsPerPage = 10 };

    private IQueryable<Product> FilteredProducts => 
        string.IsNullOrWhiteSpace(SearchTerm) 
            ? Products 
            : Products.Where(p => p.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || 
                                 p.SKU.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

    private (string CssClass, string Label) GetStockStatus(int level) => level switch
    {
        <= 5 => ("out-of-stock", "Critical"),
        <= 15 => ("low-stock", "Low"),
        _ => ("in-stock", "Healthy")
    };
}

<style>
    .modern-grid {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid var(--border-color, #e0e0e0);
        border-radius: 8px;
        overflow: hidden;
    }

    .stock-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .in-stock { background: #e8f5e9; color: #2e7d32; }
    .low-stock { background: #fff3e0; color: #ef6c00; }
    .out-of-stock { background: #ffebee; color: #c62828; }

    .btn-action {
        background: transparent;
        border: 1px solid #007bff;
        color: #007bff;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-action:hover {
        background: #007bff;
        color: white;
    }
</style>
